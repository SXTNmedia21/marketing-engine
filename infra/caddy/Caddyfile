# Marketing Engine — Caddy reverse proxy
# Local dev: tls internal (self-signed via Caddy local CA).
# Prod: replace `tls internal` with global email + auto Let's Encrypt.

{
	# email admin@example.com   # uncomment in prod for ACME
	local_certs                  # comment out in prod
}

# CRM
crm.example.com {
	tls internal
	reverse_proxy twenty-server:3000
	encode zstd gzip
}

# n8n
n8n.example.com {
	tls internal
	reverse_proxy n8n:5678
	encode zstd gzip
}

# Postiz (image listens on 5000 internally)
postiz.example.com {
	tls internal
	reverse_proxy postiz:5000
	encode zstd gzip
}

# control-api (lead/event ingest from Cloudflare Workers)
api.example.com {
	tls internal
	reverse_proxy control-api:8080
	encode zstd gzip
	@workers {
		header Cf-Worker *
	}
	header @workers X-Forwarded-By "cloudflare-worker"
}

# Grafana
grafana.example.com {
	tls internal
	reverse_proxy grafana:3000
	encode zstd gzip
}

# MinIO console
minio.example.com {
	tls internal
	reverse_proxy minio:9001
	encode zstd gzip
}
